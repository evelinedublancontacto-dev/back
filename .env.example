# Copie a .env y ajuste. .env está en .gitignore.

# desarrollo | prueba | produccion
ENTORNO=desarrollo
PUERTO=3001

# Postgres. En Railway se usa la referencia ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://eveline:eveline@localhost:5433/eveline

# Orígenes del front separados por coma. Se usan para CORS con credenciales.
ORIGENES_PERMITIDOS=http://localhost:3000

# Obligatorias en producción; en desarrollo solo avisan si faltan.
# Genere el secreto con: openssl rand -hex 32
COOKIE_SECRETO=
# Dominio padre de la cookie de sesión para que el front en www. la vea.
# Vacío en desarrollo (localhost). En producción: .evelinedublan.com
COOKIE_DOMINIO=
RESEND_API_KEY=
CORREO_REMITENTE=Eveline Dublan <citas@evelinedublan.com>
CORREO_ADMIN=

# Correr migraciones pendientes al arrancar el servidor: si | no
MIGRAR_AL_ARRANCAR=si

# Imprimir el SQL que ejecuta Sequelize (solo desarrollo): si | no
SQL_LOG=no
